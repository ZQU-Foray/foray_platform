---
# 组织 C/C++ 风格 —— foray_docs/repository_structure.md §6.6
#   缩进 4 空格 · LF · UTF-8 · 文件末尾空行
#
# ⚠️ 必须存在于仓库根目录。
#    clang-format 找不到本文件时会回退到 LLVM 默认风格（**2 空格缩进**），
#    CI 的 lint-c 就会把所有 4 空格缩进的手写代码判为违规。
#
#    注意：generated/ 下的文件不参与格式检查（见 .github/workflows/ci.yml），
#    机器产出的格式不是契约。

BasedOnStyle: LLVM
Language: Cpp

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# 指针/引用靠左：`uint8_t *out` → `uint8_t* out`
PointerAlignment: Left

# 禁止单行 if / 短函数，便于加断点与日志
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: false

# include 分组：主头文件在前，系统/标准库在后
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements

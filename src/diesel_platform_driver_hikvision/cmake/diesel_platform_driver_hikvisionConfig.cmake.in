@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

find_dependency(Threads)
find_dependency(diesel_platform)

if(@DIESEL_DRIVER_HIKVISION_NEEDS_SDK_AT_LINK@)
    find_dependency(MVS)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/diesel_platform_driver_hikvisionTargets.cmake")

# 告诉调用方编译期是否真的拿到了 MVS：OFF 时工厂只返回 kSdkUnavailable。
set(DIESEL_DRIVER_HIKVISION_HAS_SDK @DIESEL_DRIVER_HIKVISION_HAS_SDK_VALUE@)

check_required_components(diesel_platform_driver_hikvision)
